# Whisper modeli: tiny | base | small | medium
WHISPER_MODEL=small
# auto | cuda | cpu
WHISPER_DEVICE=auto
# auto (GPU: int8_float16, CPU: int8) | float16 | int8 ...
WHISPER_COMPUTE_TYPE=auto
WHISPER_CPU_THREADS=4
WHISPER_LANGUAGE=tr
WHISPER_BEAM_SIZE=5
# Sunumdaki özel terimler (boşlukla ayrılmış)
WHISPER_HOTWORDS=
# Modelleri belirli bir klasörde tutmak için (boş = varsayılan önbellek)
WHISPER_MODEL_DIR=

# silero | energy
VAD_ENGINE=silero
VAD_THRESHOLD=0.5
END_SILENCE_MS=700
MAX_UTTERANCE_SEC=12
PARTIAL_INTERVAL_SEC=1.2

SAVE_RECORDINGS=true
RECORDINGS_DIR=recordings

HOST=127.0.0.1
PORT=8000
