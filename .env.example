# Bu dosyayı .env adıyla kopyalayın (baslat.bat ilk çalıştırmada kendisi yapar).
# Gerçek ortam değişkenleri .env'deki değerleri ezer.

# --- Çalışma ortamı ---
# API_KEY tanımlıysa dosya API'si VE canlı altyazı bağlantısı anahtar ister (canlı sayfada
# Ayarlar > API anahtarı). Sunucuyu ağa açacaksanız (HOST=0.0.0.0, konferans Wi-Fi'ı) tanımlayın.
# development: API anahtarı isteğe bağlı, her callback adresine izin
# production : API_KEY zorunlu, iç ağ callback'leri yalnızca WEBHOOK_ALLOWED_HOSTS ile
APP_ENV=development
API_KEY=
WEBHOOK_SECRET=
WEBHOOK_ALLOWED_HOSTS=

# --- Diller ve modeller ---
# tr,vi: ikisi de (dil istekte verilmezse sesten bulunur). Yalnızca biri: LANGUAGES=tr
# (dil tespiti modeli yüklenmez, o dilin modeli inmez).
LANGUAGES=tr,vi
# zipformer-68m: varsayılan (Apache-2.0); zipformer-30m: CC BY-NC-ND (ince ayar ve ticari kullanım yasak)
# ince ayarlı model: klasör yolu (VI_MODEL=models/vi-ince-ayar-2026-11)
VI_MODEL=zipformer-68m
# faster-whisper-medium: varsayılan (kelime zamanlı, en doğru; ~1,5 GB, iş başına ~1,5-2 GB bellek)
# faster-whisper-small: daha hızlı (1 dk ses <= 1 dk hedefi medium ile aşılırsa)
# omnilingual-300m: daha hızlı seçenek (1 dk ses <= 1 dk hedefi aşılırsa)
TR_MODEL=faster-whisper-medium
# faster-whisper nerede çalışsın: auto (GPU varsa GPU, açılamazsa CPU) | cuda | cpu
# Sunucu (yalnızca CPU, 4000 mesaj) için cpu; kendi bilgisayarında canlı altyazı için auto.
WHISPER_DEVICE=auto
# auto: GPU'da int8_float16, CPU'da int8
WHISPER_COMPUTE_TYPE=auto
# Türkçe: sunumdaki/konuşmadaki özel terimler ve adlar, boşlukla ayrılmış (Whisper'a ipucu)
HOTWORDS=
# Vietnamca: terim dosyası, satır başına bir terim, BÜYÜK HARF (ör. hotwords/tibbi_vi.txt)
VI_HOTWORDS=
MODELS_DIR=models
VERIFY_MODELS=1

# --- Performans ---
# Her eşzamanlı iş ONNX_THREADS çekirdek kullanır. CONCURRENCY=auto: çekirdek / ONNX_THREADS
# ile belleğin izin verdiğinin küçüğü (modellerin bellek tahmini: catalog.MODEL_MEMORY_GB;
# seçilen sayı ve gerekçesi açılışta yazılır). 12 iş parçacığı + 16 GB + Türkçe medium:
# yerel modda 6, tam modda Türkçe kuyruğu 4 süreç. Sanal çekirdekler bu hesapta az
# kazandırır; en iyisini ölçün ve buraya yazın:
#   python benchmarks\kabul_testi.py --threads 2 --es-zamanli 3 a.wav b.wav c.wav ...
#   python benchmarks\kabul_testi.py --threads 2 --es-zamanli 6 a.wav b.wav c.wav ...
ONNX_THREADS=2
# Türkçe (faster-whisper) bir çözümün iş parçacığı; auto = fiziksel çekirdek (2-8).
# Aynı anda çalışan Whisper çözümü = mantıksal çekirdek / bu değer (12 / 6 = 2); fazlası sırada.
# Tek iş gelince de işlemci boş kalmaz (2 iken 2 dk ses 296 sn sürüyordu).
WHISPER_THREADS=auto
CONCURRENCY=auto

# --- Konuşmacı ---
# 0 = sesten bul; istekte num_speakers verilirse o kullanılır
NUM_SPEAKERS=0

# --- Dosyalar ve saklama ---
DATA_DIR=data/uploads
MAX_UPLOAD_MB=100
MAX_AUDIO_MINUTES=60
# biten işin ses dosyası kaç saat sonra silinsin (0 = silme)
AUDIO_RETENTION_HOURS=24
# biten işin kaydı ve sonucu kaç gün sonra silinsin (0 = silme)
RESULT_RETENTION_DAYS=30
PROCESSING_STALE_SEC=1800
# QUEUED'da bundan uzun kalan iş, kuyruğu boşsa yeniden kuyruğa konur (tam mod; sn)
QUEUED_STALE_SEC=300
MAX_JOB_ATTEMPTS=3
# İşlem profili (istekte profile= ile iş başına): full | feedback
#   feedback: kısa geri bildirim mesajları için; PIPELINE_MIN_DIARIZE_SEC'ten kısa seste
#   konuşmacı ayırma atlanır, Whisper beam 1
PIPELINE_PROFILE=full
PIPELINE_MIN_DIARIZE_SEC=10
# Callback'e hangi olaylarda bildirim gitsin (istekte notify= ile iş başına):
#   running (işlenmeye başladı), done, failed, rejected
NOTIFY_EVENTS=done,failed,rejected
# webhook teslimi en fazla bu kadar denenir (10 sn'den 1 saate artan aralıkla), sonra "ölü":
# GET /webhooks/dead ile görülür, POST /webhooks/{id}/retry ile yeniden denenir
WEBHOOK_MAX_ATTEMPTS=8
# Aşırı yük: bu kadar iş beklerken yeni istek 503 + Retry-After alır (0 = sınırsız)
MAX_PENDING_JOBS=10000
# İstemci başına dakikalık istek sınırı; 0 = kapalı (entegre sistem 4000 mesajı bir anda atabilir)
RATE_LIMIT_PER_MINUTE=0

# Kontrol edilmiş sonucu veri setine aktarma (arayüzde "Veri setine ekle"). Varsayılan kapalı:
# açınca kayıtlar DATASET_DIR/bekleyen'e düşer, scripts/veri_seti.py ile test ya da eğitime onaylanır.
# Hasta/kişisel ses içerir: yalnızca kullanım izni olan kayıtlar için açın.
ENABLE_DATASET_EXPORT=0
DATASET_DIR=data/veri_seti

# Yerel mod veritabanı: boşsa data/uploads/jobs.db (SQLite, kurulum gerekmez)
LOCAL_DATABASE_URL=

# --- Canlı altyazı (http://127.0.0.1:8000/canli) ---
# Sayfanın varsayılan dili: tr | vi | auto (auto: ilk cümleden bulunur, oturum boyunca sabit)
LIVE_LANGUAGE=tr
# Türkçe canlı model. Boşsa TR_MODEL ile aynı (bellekte bir kez). Vietnamca hep VI_MODEL
# (Zipformer gerçek zamanın ~40 katı hızlı). 4 GB GPU'da Türkçe gecikme 2 sn'yi aşarsa:
# LIVE_MODEL=faster-whisper-small (indirmek: python scripts\download_models.py --tr faster-whisper-small)
LIVE_MODEL=
# silero (önerilen; models/silero_vad.onnx) | energy (model gerektirmez)
LIVE_VAD=silero
LIVE_VAD_THRESHOLD=0.5
# cümle bitti demek için gereken duraklama (ms); cümleler bölünüyorsa artırın (900-1000)
END_SILENCE_MS=700
# durmadan konuşulursa cümle en fazla bu kadar (sn)
MAX_UTTERANCE_SEC=12
# ara metin sıklığı (sn); yavaş bilgisayarda artırın ya da 0 yapın
PARTIAL_INTERVAL_SEC=1.2
SAVE_RECORDINGS=true
RECORDINGS_DIR=recordings
# oturum bitince kayıt toplu işe gitsin: konuşmacı ayrımlı, düzeltilebilir transkript
LIVE_AUTO_ANALYZE=true
# Oturum bitince bildirim (webhook) adresi; boşsa gitmez. Önce 'live.ended' (canlı metin),
# konuşmacı ayrımı bitince aynı adrese 'job.done'. İmza: WEBHOOK_SECRET. docs/entegrasyon.md 4.1
LIVE_WEBHOOK_URL=
# Bağlantı koparsa oturum bu kadar sn bekler; sayfa geri bağlanırsa aynı oturum sürer
# (aynı kayıt, satırlar; kopukken çekilen ses tarayıcıda biriktirilip gönderilir). 0: beklemez.
LIVE_RESUME_SEC=30
# recordings/ altındaki canlı oturum kayıtları kaç gün sonra silinsin (0 = silme)
RECORDINGS_RETENTION_DAYS=30

# --- Yalnızca TAM mod (baslat_tam.bat): PostgreSQL + Redis ---
# Şema kod üzerinden (SQLAlchemy + Alembic) kurulur/güncellenir; elle SQL gerekmez.
DATABASE_URL=postgresql://asr:asr@localhost:5432/asr
REDIS_URL=redis://localhost:6379/0
